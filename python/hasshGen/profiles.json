 "terrapin-no-chacha20": {
  "description": "Terrapin (CVE-2023-48795) workaround: ChaCha20-Poly1305 removed",
  "source": "https://terrapin-attack.com/",
  "options": {
   "Ciphers": "-chacha20-poly1305@openssh.com"
  }
 },
